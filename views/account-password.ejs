<%- include('partials/header', { title: 'Change password' }) %>
<h1>Change your password</h1>
<% if (error) { %><div class="banner error"><%= error %></div><% } %>
<% if (legacy) { %>
  <div class="banner warn">Your login still comes from Railway's settings, so it can't be changed here yet. The Admin needs to finish setting up users first.</div>
<% } else { %>
<form method="post" action="/account/password" class="card narrow-form">
  <input type="text" name="username" value="<%= user %>" autocomplete="username" hidden>
  <label>Current password <input type="password" name="Current" autocomplete="current-password" required></label>
  <label>New password <input type="password" name="Password" autocomplete="new-password" minlength="<%= min %>" required></label>
  <label>Type the new password again <input type="password" name="Password2" autocomplete="new-password" minlength="<%= min %>" required></label>
  <p class="muted small">At least <%= min %> characters. A short sentence is easy to remember and hard to guess, e.g. <em>three pink coats on Tuesday</em>.</p>
  <button type="submit" class="primary">Change password</button>
</form>
<% } %>
<%- include('partials/footer') %>
