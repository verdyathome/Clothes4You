<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#ffffff">
  <title><%= typeof title !== 'undefined' ? title + ' · ' : '' %>Clothing Portal</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<% if (user) { %>
<header class="topbar">
  <a class="brand" href="/">Clothing Portal</a>
  <nav aria-label="Main">
    <% [['/', 'Dashboard', path === '/'],
        ['/items', 'Items', path.startsWith('/items')],
        ['/purchases', 'Purchases', path.startsWith('/purchases')],
        ['/sales', 'Sales', path.startsWith('/sales') || path.startsWith('/import')],
        ['/expenses', 'Expenses', path.startsWith('/expenses')]].forEach(([href, label, on]) => { %>
      <a href="<%= href %>" class="<%= on ? 'on' : '' %>"<%- on ? ' aria-current="page"' : '' %>><%= label %></a>
    <% }) %>
  </nav>
  <form method="post" action="/logout" class="logout"><button type="submit" class="link"><%= user %> · Log out</button></form>
</header>
<% } %>
<main>
<% if (backend === 'memory') { %><div class="banner warn">Test mode: data is held in memory and lost on restart.</div><% } %>
<% if (flash) { %><div class="banner <%= flash.type %>"><%= flash.text %></div><% } %>
