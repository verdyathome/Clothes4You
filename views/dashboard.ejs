<%- include('partials/header', { title: 'Dashboard' }) %>
<div class="head-row">
  <h1>Tax year <%= d.taxYear %></h1>
  <form method="get" class="inline">
    <input type="hidden" name="cy" value="<%= cy %>">
    <select name="ty" onchange="this.form.submit()">
      <% years.forEach(y => { %><option <%= y === d.taxYear ? 'selected' : '' %>><%= y %></option><% }) %>
    </select>
  </form>
</div>
<p class="muted"><%= ukDate(d.range.start) %> to <%= ukDate(d.range.end) %> · business only · cash basis</p>

<div class="actions">
  <a class="btn primary" href="/sales/new">+ Record a sale</a>
  <a class="btn" href="/purchases/new">+ Stock purchase</a>
  <a class="btn" href="/expenses/new">+ Expense</a>
  <a class="btn" href="/items/new">+ Personal item</a>
  <a class="btn" href="/import/ebay">Import eBay CSV</a>
</div>

<div class="tiles">
  <div class="tile"><span>Turnover</span><strong><%= money(d.turnover) %></strong><small><%= d.salesCount %> sale(s)<%= d.refundsTotal ? ', less ' + money(d.refundsTotal) + ' refunds' : '' %></small></div>
  <div class="tile"><span>Stock bought</span><strong><%= money(d.stockPurchases) %></strong><small>paid this tax year</small></div>
  <div class="tile"><span>Other expenses</span><strong><%= money(d.totalExpenses - d.stockPurchases) %></strong><small>fees, postage &amp; costs</small></div>
  <div class="tile"><span>Net profit</span><strong><%= money(d.profit) %></strong><small>turnover less all expenses</small></div>
</div>

<div class="grid2">
  <section class="card">
    <div class="head-row"><h2>Self Assessment (SA103)</h2><a class="btn" href="/export/<%= d.taxYear %>.xlsx">Download Excel</a></div>
    <table class="kv">
      <tr><td>Sales and postage charged</td><td><%= money(d.grossSales) %></td></tr>
      <% if (d.refundsTotal) { %><tr><td>Less refunds</td><td>−<%= money(d.refundsTotal) %></td></tr><% } %>
      <tr class="total"><td>Turnover</td><td><%= money(d.turnover) %></td></tr>
      <% d.categories.filter(c => c.amount).forEach(c => { %>
        <tr><td><%= c.name %></td><td><%= money(c.amount) %></td></tr>
      <% }) %>
      <tr class="total"><td>Total allowable expenses</td><td><%= money(d.totalExpenses) %></td></tr>
      <tr class="total"><td>Net profit</td><td><%= money(d.profit) %></td></tr>
    </table>
    <p class="muted small">Platform fees are counted as other allowable expenses and postage paid as office costs. Check figures with an accountant before filing.</p>
  </section>

  <section class="card">
    <h2>Stock &amp; item profit</h2>
    <table class="kv">
      <tr><td>Unsold business items (today)</td><td><%= d.unsoldCount %></td></tr>
      <tr><td>Unsold stock at cost</td><td><%= money(d.unsoldValue) %></td></tr>
      <tr><td>Cost of items sold this year</td><td><%= money(d.costOfItemsSold) %></td></tr>
      <tr><td>Sale price minus item cost</td><td><%= money(d.grossItemProfit) %></td></tr>
    </table>
    <% if (d.personalSalesCount) { %><p class="muted small"><%= d.personalSalesCount %> personal item sale(s) this tax year are excluded from the figures.</p><% } %>
  </section>
</div>

<section class="card">
  <div class="head-row">
    <h2>Platform reporting check — calendar year <%= cy %></h2>
    <form method="get" class="inline">
      <input type="hidden" name="ty" value="<%= d.taxYear %>">
      <select name="cy" onchange="this.form.submit()">
        <% calYears.forEach(y => { %><option <%= y === cy ? 'selected' : '' %>><%= y %></option><% }) %>
      </select>
    </form>
  </div>
  <p class="muted small">Vinted and eBay report sellers to HMRC per calendar year once they reach 30 sales or about £1,700, <em>including personal items</em>. These totals should line up with what each platform reports.</p>
  <% const names = Object.keys(platforms); %>
  <% if (!names.length) { %><p>No sales in <%= cy %>.</p><% } else { %>
  <table class="list">
    <thead><tr><th>Platform</th><th>Sales</th><th class="num">Gross</th><th class="num">Refunds</th><th class="num">Business</th><th class="num">Personal</th></tr></thead>
    <tbody>
    <% names.forEach(n => { const p = platforms[n]; %>
      <tr class="<%= p.count >= 30 || p.gross >= 1700 ? 'flag' : '' %>"><td><%= n %></td><td><%= p.count %></td><td class="num"><%= money(p.gross) %></td><td class="num"><%= money(p.refunds) %></td><td class="num"><%= money(p.business) %></td><td class="num"><%= money(p.personal) %></td></tr>
    <% }) %>
    </tbody>
  </table>
  <% } %>
</section>
<%- include('partials/footer') %>
