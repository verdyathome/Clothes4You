<%- include('partials/header', { title: 'Sales' }) %>
<div class="head-row">
  <h1>Sales <%= ty %></h1>
  <form method="get" class="inline">
    <select name="ty" onchange="this.form.submit()"><% years.forEach(y => { %><option <%= y === ty ? 'selected' : '' %>><%= y %></option><% }) %></select>
  </form>
  <a class="btn primary" href="/sales/new">+ Record sale</a>
</div>
<% if (!sales.length) { %><p>No sales in this tax year yet.</p><% } else { %>
<table class="list">
  <thead><tr><th>Date</th><th>Item</th><th>Where</th><th>Type</th><th class="num">Price</th><th class="num">Postage in</th><th class="num">Fee</th><th class="num">Postage out</th></tr></thead>
  <tbody>
  <% sales.forEach(s => { %>
    <tr class="<%= s.Ownership === 'Personal' ? 'personal' : '' %>">
      <td><%= ukDate(s.SaleDate) %></td><td><a href="/items/<%= s.ItemID %>">#<%= s.ItemID %></a></td><td><%= s.Channel %></td><td><%= s.Ownership %></td>
      <td class="num"><%= money(s.SalePrice) %></td><td class="num"><%= money(s.BuyerPostage) %></td><td class="num"><%= money(s.PlatformFee) %></td><td class="num"><%= money(s.PostageCost) %></td>
    </tr>
  <% }) %>
  </tbody>
</table>
<% } %>
<%- include('partials/footer') %>
